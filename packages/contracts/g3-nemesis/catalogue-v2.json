  "cooldownEvidence": "No temporal purchase cooldown; purchase removes local offers within radius1000 at(x,y-25). Source recipient coordinate key suppresses repeat ability at the same integer x,y.",
  "offerGeneration": {
    "depthTierByLevel": {
      "2": 1,
      "5": 2,
      "9": 3,
      "12": 4,
      "16": 5,
      "20": 6,
      "25": 6
    },
    "levelExpression": "floor(y/512)",
    "priceExpression": "10*floor(level^1.5)+15",
    "offersPerSpawn": 3,
    "selection": "source game-seeded weighted selection, remove chosen ID from persistent tier pool; authoritative offering/provenance not implemented by this catalogue"
  },
  "timedStacking": "Existing entity named nemesis_<id>: extend LifetimeComponent.kill_frame by requested frames; otherwise trusted effect.xml/optional GameEffect.frames + LifetimeComponent + attach to local player. No-player returns without application.",
  "points": {
    "currency": "Nemesis points (NP), separate from gold",
    "initial": 0,
    "earnings": "Source local player/child attributed enemy death with DamageModelComponent: floor(max_hp*10); NEMESIS_ENEMY exclusion occurs AFTER points credit. Authoritative earning provenance/durable ledger not implemented."
  },
  "status": "all28 trusted dispatch-plan authorization; isolated durable purchase fixtures only; no client effect or earning/offering/installed capability acceptance",
